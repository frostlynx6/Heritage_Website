generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
}

model User {
  id        String      @id @default(cuid())
  name      String?
  email     String      @unique
  password  String
  createdAt DateTime    @default(now())
  
  badges    UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  tripId    String   
  earnedAt  DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@unique([userId, tripId]) 
}